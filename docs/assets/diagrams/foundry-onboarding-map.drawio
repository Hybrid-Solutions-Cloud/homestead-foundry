<mxfile host="app.diagrams.net" modified="2026-07-28T00:00:00.000Z" agent="Codex" version="27.0.0">
  <diagram id="foundry-onboarding" name="Onboarding journey">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;div style=&quot;font-size:28px;font-weight:700;color:#102A43;&quot;&gt;Homestead Foundry: from zero to your first useful model call&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#486581;margin-top:6px;&quot;&gt;Follow the numbered path. Each card maps to one public guide, with a clear decision gate before Azure changes or spend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="35" width="1480" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="plan-band" value="1. DESIGN YOUR ENVIRONMENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=none;fontColor=#1D4ED8;fontStyle=1;fontSize=15;align=left;spacingLeft=20;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="135" width="1480" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="card-prereqs" value="&lt;b&gt;1. Confirm prerequisites&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#486581&quot;&gt;Subscription, Azure CLI, Key Vault, Node.js&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;spacing=16;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="250" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="card-region" value="&lt;b&gt;2. Choose one region&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#486581&quot;&gt;Check what the live Azure catalog actually offers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;spacing=16;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="220" width="250" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="card-registry" value="&lt;b&gt;3. Create your registry&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#486581&quot;&gt;Copy the starter, then keep only the models you want&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;spacing=16;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="220" width="250" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="card-catalog" value="&lt;b&gt;4. Resolve the live catalog&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#486581&quot;&gt;Generate current model names and versions for your region&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;spacing=16;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="220" width="250" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="models-available" value="Every deployed model available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1290" y="215" width="160" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="adjust-roster" value="Adjust roster or region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontColor=#9F1239;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1280" y="355" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="build-band" value="2. PREVIEW, DEPLOY, AND PROVE IT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEFDF5;strokeColor=none;fontColor=#047857;fontStyle=1;fontSize=15;align=left;spacingLeft=20;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="1480" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="card-access" value="&lt;b&gt;5. Configure access&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#486581&quot;&gt;Create image and speech Entra security groups&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;spacing=16;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="525" width="250" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="card-parameters" value="&lt;b&gt;6. Complete private parameters&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#486581&quot;&gt;Names, group IDs, budget, alert email, Key Vault&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;spacing=16;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="525" width="250" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="card-preview" value="&lt;b&gt;7. Build and run what-if&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#486581&quot;&gt;Review every proposed Azure change before deployment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;spacing=16;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="525" width="250" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="expected-changes" value="Only expected changes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="520" width="180" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="card-deploy" value="&lt;b&gt;8. Approve and deploy&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#486581&quot;&gt;A human explicitly approves the resource-creating deployment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;spacing=16;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="525" width="250" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="card-smoke" value="&lt;b&gt;9. Smoke test all three paths&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#486581&quot;&gt;Image, reasoning, and speech must each make a real call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;spacing=16;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="680" width="320" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="ready" value="&lt;b&gt;Your Foundry environment is ready&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#14532D&quot;&gt;Resources exist, data-plane access works, and your endpoint has served a real response.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;fontSize=15;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="820" width="620" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="use-band" value="3. NOW CHOOSE YOUR PATH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0FF;strokeColor=none;fontColor=#6D28D9;fontStyle=1;fontSize=15;align=left;spacingLeft=20;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="950" width="1480" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;Call models directly&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#486581&quot;&gt;curl, PowerShell, Python, JavaScript, or C#&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;spacing=16;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="1035" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="tools" value="&lt;b&gt;Connect your tools&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#486581&quot;&gt;VS Code, Continue, Cursor, Cline, Roo, and web UIs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;spacing=16;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="1035" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="agents" value="&lt;b&gt;Build an agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#486581&quot;&gt;Foundry Agent Service or your own application runtime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;spacing=16;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1035" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="card-prereqs" target="card-region"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="card-region" target="card-registry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="card-registry" target="card-catalog"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="card-catalog" target="models-available"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#E11D48;fontColor=#9F1239;fontStyle=1;" edge="1" parent="1" source="models-available" target="adjust-roster"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#059669;fontColor=#047857;fontStyle=1;" edge="1" parent="1" source="models-available" target="card-access"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#059669;strokeWidth=2;exitX=0;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="card-access" target="card-parameters"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#059669;strokeWidth=2;exitX=0;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="card-parameters" target="card-preview"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#059669;strokeWidth=2;exitX=0;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="card-preview" target="expected-changes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#059669;fontColor=#047857;fontStyle=1;exitX=0;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="expected-changes" target="card-deploy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="card-deploy" target="card-smoke"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="card-smoke" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=2;" edge="1" parent="1" source="ready" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=2;" edge="1" parent="1" source="ready" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=2;" edge="1" parent="1" source="ready" target="agents"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
